# Copy to .env, edit credentials, and chmod 600 .env.
# Only .env in the working directory is read. Process env takes priority.
NTPUVPN_USERNAME=your-student-id
NTPUVPN_PASSWORD='replace-with-your-password'

# Optional VPN route overrides (these are the defaults):
# NTPUVPN_VPN_NETWORK=10.0.0.0
# NTPUVPN_VPN_MASK=255.0.0.0
